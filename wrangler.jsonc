{
  "name": "prevcontrol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create prevcontrol-db",
    "db:migrate": "wrangler d1 migrations apply prevcontrol-db --local && wrangler d1 migrations apply prevcontrol-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply prevcontrol-db --local"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
